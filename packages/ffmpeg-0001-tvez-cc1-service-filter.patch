diff --git a/libavcodec/ccaption_dec.c b/libavcodec/ccaption_dec.c
--- a/libavcodec/ccaption_dec.c
+++ b/libavcodec/ccaption_dec.c
@@ -248,6 +248,9 @@ typedef struct CCaptionSubContext {
     int real_time;
     int real_time_latency_msec;
     int data_field;
+    /* -1: all channels (legacy), 0: CC1/CC3, 1: CC2/CC4. */
+    int cc_channel;
+    int active_cc_channel;
     struct Screen screen[2];
     int active_screen;
     uint8_t cursor_row;
@@ -279,6 +282,7 @@ static av_cold int init_decoder(AVCodecContext *avctx)
     ctx->bg_color = CCCOL_BLACK;
     ctx->rollup = 2;
     ctx->cursor_row = 10;
+    ctx->active_cc_channel = 0;
     return ff_ass_subtitle_header(avctx, "Monospace",
                                   ASS_DEFAULT_FONT_SIZE,
                                   ASS_DEFAULT_COLOR,
@@ -312,6 +316,7 @@ static av_cold void flush_decoder(AVCodecContext *avctx)
     ctx->bg_color = CCCOL_BLACK;
     ctx->cursor_charset = 0;
     ctx->active_screen = 0;
+    ctx->active_cc_channel = 0;
     ctx->last_real_time = 0;
     ctx->screen_touched = 0;
     ctx->buffer_changed = 0;
@@ -834,7 +839,19 @@ static int decode(AVCodecContext *avctx, AVSubtitle *sub,
         if (cc_type != ctx->data_field)
             continue;
 
-        ret = process_cc608(ctx, hi & 0x7f, bptr[i + 2] & 0x7f);
+        /* CEA-608 field 1 contains CC1 and CC2 services. Distinguish
+         * the channel indicated by control/preamble pairs; printable pairs
+         * continue on the most recently signalled channel. Experimental.
+         */
+        hi &= 0x7f;
+        const uint8_t lo = bptr[i + 2] & 0x7f;
+        if (hi >= 0x10 && hi <= 0x1f && lo >= 0x20)
+            ctx->active_cc_channel = !!(hi & 0x08);
+        if (ctx->cc_channel >= 0 &&
+            ctx->active_cc_channel != ctx->cc_channel)
+            continue;
+
+        ret = process_cc608(ctx, hi, lo);
         if (ret < 0)
             return ret;
 
@@ -896,6 +913,7 @@ static const AVOption options[] = {
     { "real_time", "emit subtitle events as they are decoded for real-time display", OFFSET(real_time), AV_OPT_TYPE_BOOL, { .i64 = 0 }, 0, 1, SD },
     { "real_time_latency_msec", "minimum elapsed time between emitting real-time subtitle events", OFFSET(real_time_latency_msec), AV_OPT_TYPE_INT, { .i64 = 200 }, 0, 500, SD },
     { "data_field", "select data field", OFFSET(data_field), AV_OPT_TYPE_INT, { .i64 = -1 }, -1, 1, SD, .unit = "data_field" },
+    { "cc_channel", "select CEA-608 channel within a field (-1=both, 0=first, 1=second)", OFFSET(cc_channel), AV_OPT_TYPE_INT, { .i64 = -1 }, -1, 1, SD },
     { "auto",   "pick first one that appears", 0, AV_OPT_TYPE_CONST, { .i64 =-1 }, 0, 0, SD, .unit = "data_field" },
     { "first",  NULL, 0, AV_OPT_TYPE_CONST, { .i64 = 0 }, 0, 0, SD, .unit = "data_field" },
     { "second", NULL, 0, AV_OPT_TYPE_CONST, { .i64 = 1 }, 0, 0, SD, .unit = "data_field" },
